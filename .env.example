# Database Configuration
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=thermal_db
POSTGRES_PORT=5432

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_CESIUM_ION_ACCESS_TOKEN=your_cesium_ion_access_token_here

# NASA FIRMS Configuration
FIRMS_MAP_KEY=your_nasa_firms_api_key_here
FIRMS_SOURCE=VIIRS_SNPP_NRT
# Area bbox string 'min_lon,min_lat,max_lon,max_lat' (default India region: 68,7,97,36)
FIRMS_AREA=68,7,97,36
FIRMS_DAYS=1
FIRMS_API_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api
FIRMS_INGEST_INTERVAL_MINUTES=15

# OSM Configuration
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_BBOX=68,7,97,36

# Phase 3: Temporal & Intelligence Parameters
TEMPORAL_LOOKBACK_DAYS=90
SPATIAL_CLUSTER_RADIUS_METERS=1000.0
PERSISTENCE_MIN_ACTIVE_DAYS=5
RECURRING_MIN_DETECTIONS=2
ABNORMAL_FRP_MULTIPLIER=2.5
INDUSTRIAL_PROXIMITY_THRESHOLD_METERS=2000.0
# Set DEMO_MODE=true for testing without active NASA FIRMS credentials
DEMO_MODE=false

# Phase 4: Land Cover & Satellite Intelligence
ESA_WORLDCOVER_VERSION=v200 (2021)
ESA_WORLDCOVER_DATA_PATH=
SATELLITE_PROVIDER=sentinel2
MAX_SATELLITE_CLOUD_COVER=30.0
SATELLITE_SEARCH_DAYS_WINDOW=10
STAC_API_URL=https://earth-search.aws.element84.com/v1
MODEL_REGISTRY_PATH=models
ACTIVE_MODEL_VERSION=xgb-v1
FALLBACK_TO_PROTOTYPE=true
